---
import '../styles/global.css';
import { t } from '@apnacircle/i18n';
import HeaderAccount from '../components/HeaderAccount.astro';
import { CitySwitcher, isNavigationActive, MobileNavigation, PRIMARY_NAV_LINKS } from '@apnacircle/ui';
import { serializeJsonLd } from '../lib/meetups.js';
import { isPrivateNoindexPath } from '../lib/security-headers.js';
import { articleJsonLd, breadcrumbJsonLd, publicUrl, siteJsonLd, socialImage, verificationToken, type Crumb } from '../lib/seo.js';

export interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  activeCitySlug?: string;
  /** Path (no query string) that search engines should treat as the canonical URL. */
  canonicalPath?: string;
  breadcrumbs?: readonly Crumb[];
  articleAuthor?: string;
  structuredData?: Record<string, unknown> | null;
}

const {
  title,
  description = t('brand.description'),
  noindex = false,
  activeCitySlug = 'saharanpur',
  canonicalPath,
  breadcrumbs = [],
  articleAuthor,
  structuredData,
} = Astro.props;

const currentPath = Astro.url.pathname;
const fullTitle = title === t('brand.name') ? title : `${title} · ${t('brand.name')}`;
const site = Astro.site;
const privatePage = isPrivateNoindexPath(Astro.originPathname);
const unavailable = (Astro.response.status ?? 200) >= 400;
const indexable = Boolean(site && !noindex && !privatePage && !unavailable);
const canonical = site && !privatePage && !unavailable && (indexable || canonicalPath)
  ? publicUrl(site, canonicalPath ?? currentPath) : undefined;
const home = currentPath === '/';
const googleToken = indexable && home ? verificationToken(import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION) : undefined;
const graphs: Record<string, unknown>[] = [];
if (site && canonical && indexable) {
  if (home) graphs.push(siteJsonLd(site, t('brand.name'), description));
  if (breadcrumbs.length > 1) graphs.push(breadcrumbJsonLd(site, breadcrumbs, canonical));
  if (articleAuthor) graphs.push(articleJsonLd(site, canonical, { title, description, author: articleAuthor }));
  if (structuredData) graphs.push(structuredData);
}

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content={privatePage || unavailable || !site ? 'noindex, nofollow' : 'noindex, follow'} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {site && indexable && canonical && (
      <>
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:type" content={articleAuthor ? 'article' : 'website'} />
        <meta property="og:site_name" content={t('brand.name')} />
        <meta property="og:locale" content="en_IN" />
        <meta property="og:image" content={publicUrl(site, socialImage)} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={t('brand.name')} />
      </>
    )}
    {googleToken && <meta name="google-site-verification" content={googleToken} />}
    {graphs.map((graph) => <script type="application/ld+json" set:html={serializeJsonLd(graph)} />)}
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-[var(--ac-bg)] text-[var(--ac-ink)]">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-xl focus:bg-[var(--ac-accent)] focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white"
    >
      {t('nav.skipToContent')}
    </a>

    <header class="relative border-b border-[var(--ac-border)] bg-[var(--ac-surface)]">
      <div class="mx-auto flex min-h-16 max-w-6xl items-center justify-between gap-2 px-3 sm:gap-4 sm:px-6">
        <a
          href="/"
          class="flex shrink-0 items-center gap-2 whitespace-nowrap rounded-lg text-base font-bold tracking-tight text-[var(--ac-ink)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--ac-accent)] sm:text-lg"
        >
          <img src="/apnacircle-mark.png" width="32" height="32" alt="" />
          <span>{t('brand.name')}</span>
        </a>

        <nav aria-label={t('nav.primary')} class="hidden lg:block">
          <ul class="flex items-center gap-0.5 whitespace-nowrap xl:gap-1">
            {PRIMARY_NAV_LINKS.map(({ href, key }) => {
              const isActive = isNavigationActive(currentPath, href);
              return (
                <li>
                  <a
                    href={href}
                    aria-current={isActive ? 'page' : undefined}
                    class={`inline-flex min-h-11 items-center rounded-lg px-2.5 text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--ac-accent)] xl:px-3 ${
                      isActive
                        ? 'bg-[var(--ac-accent-soft)] text-[var(--ac-accent)]'
                        : 'text-[var(--ac-ink)] hover:bg-[var(--ac-surface-muted)]'
                    }`}
                  >
                    {t(key)}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>

        <div class="flex shrink-0 items-center gap-2">
          <CitySwitcher activeSlug={activeCitySlug} />
          <HeaderAccount server:defer>
            <HeaderAccount slot="fallback" guestOnly />
          </HeaderAccount>
          <MobileNavigation currentPath={currentPath} />
        </div>
      </div>
    </header>

    <main id="main-content" class="mx-auto w-full max-w-6xl flex-1 px-4 py-8 sm:px-6 sm:py-12">
      {breadcrumbs.length > 1 && (
        <nav aria-label={t('seo.breadcrumbs')} class="mb-4 text-xs text-[var(--ac-ink-muted)]">
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
            {breadcrumbs.map(({ label, path }, index) => (
              <li class="flex items-center gap-x-2">
                {index > 0 && <span aria-hidden="true">/</span>}
                {path ? <a href={path} class="hover:text-[var(--ac-accent)]">{label}</a> : <span aria-current="page" class="font-medium text-[var(--ac-ink)]">{label}</span>}
              </li>
            ))}
          </ol>
        </nav>
      )}
      <slot />
    </main>

    <footer class="border-t border-[var(--ac-border)] bg-[var(--ac-surface)]">
      <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
          <div>
            <p class="text-base font-bold text-[var(--ac-ink)]">{t('brand.name')}</p>
            <p class="mt-2 text-sm text-[var(--ac-ink-muted)]">{t('brand.tagline')}</p>
            <p class="mt-2 text-xs text-[var(--ac-ink-muted)]">{t('brand.description')}</p>
          </div>

          <div>
            <h2 class="text-sm font-semibold text-[var(--ac-ink)]">
              {t('footer.exploreHeading')}
            </h2>
            <ul class="mt-3 space-y-2 text-sm text-[var(--ac-ink-muted)]">
              <li><a href="/cities" class="hover:text-[var(--ac-accent)]">{t('nav.cities')}</a></li>
              <li><a href="/saharanpur" class="hover:text-[var(--ac-accent)]">Saharanpur</a></li>
              <li><a href="/meetups" class="hover:text-[var(--ac-accent)]">{t('nav.meetups')}</a></li>
              <li><a href="/places" class="hover:text-[var(--ac-accent)]">{t('nav.places')}</a></li>
              <li><a href="/me/profile" class="hover:text-[var(--ac-accent)]">{t('profile.title')}</a></li>
              <li><a href="/about" class="hover:text-[var(--ac-accent)]">{t('nav.about')}</a></li>
              <li><a href="/feedback" class="hover:text-[var(--ac-accent)]">{t('nav.feedback')}</a></li>
            </ul>
          </div>

          <div>
            <h2 class="text-sm font-semibold text-[var(--ac-ink)]">
              {t('footer.safetyHeading')}
            </h2>
            <ul class="mt-3 space-y-2 text-sm text-[var(--ac-ink-muted)]">
              <li><a href="/safety" class="hover:text-[var(--ac-accent)]">{t('footer.safetyLink')}</a></li>
              <li><a href="/community-guidelines" class="hover:text-[var(--ac-accent)]">{t('footer.communityLink')}</a></li>
              <li><a href="/host-guidelines" class="hover:text-[var(--ac-accent)]">{t('footer.hostLink')}</a></li>
              <li><a href="/grievance" class="hover:text-[var(--ac-accent)]">{t('footer.grievanceLink')}</a></li>
            </ul>
          </div>

          <div>
            <h2 class="text-sm font-semibold text-[var(--ac-ink)]">
              {t('footer.legalHeading')}
            </h2>
            <ul class="mt-3 space-y-2 text-sm text-[var(--ac-ink-muted)]">
              <li><a href="/privacy" class="hover:text-[var(--ac-accent)]">{t('footer.privacyLink')}</a></li>
              <li><a href="/terms" class="hover:text-[var(--ac-accent)]">{t('footer.termsLink')}</a></li>
              <li><a href="/cookies" class="hover:text-[var(--ac-accent)]">{t('footer.cookiesLink')}</a></li>
              <li><a href="/legal/requests" class="hover:text-[var(--ac-accent)]">{t('footer.lawEnforcementLink')}</a></li>
            </ul>
          </div>
        </div>

        <div class="mt-8 border-t border-[var(--ac-border)] pt-6 text-xs text-[var(--ac-ink-muted)]">
          <p>{t('footer.copyright')}</p>
        </div>
      </div>
    </footer>
  </body>
</html>
