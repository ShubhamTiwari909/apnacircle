---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '@apnacircle/i18n';
import { getCategoryBySlug } from '@apnacircle/types';
import { PlaceCard } from '@apnacircle/ui';

const places = await getCollection('places', ({ data }) => data.status === 'published');
---

<BaseLayout title={t('places.pageTitle')} description={t('places.pageLead')}>
  <header class="max-w-3xl">
    <h1 class="text-3xl font-bold tracking-tight text-[var(--ac-ink)] sm:text-4xl">
      {t('places.pageTitle')}
    </h1>
    <p class="mt-3 text-base text-[var(--ac-ink-muted)]">{t('places.pageLead')}</p>
  </header>

  <section class="mt-8 grid gap-5 sm:grid-cols-2">
    {
      places.map((place) => {
        const cat = getCategoryBySlug(place.data.categorySlug);
        return (
          <PlaceCard
            name={place.data.name}
            locality={place.data.locality}
            categoryLabel={cat?.name ?? place.data.categorySlug}
            summary={place.data.summary}
            publicAccessNote={place.data.publicAccessNote}
            lastVerifiedAt={t('article.verifiedOn', { date: place.data.lastVerifiedAt })}
            href={`/${place.data.citySlug}/${place.data.categorySlug}`}
          />
        );
      })
    }
  </section>
</BaseLayout>
