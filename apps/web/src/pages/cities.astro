---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '@apnacircle/i18n';
import { CITIES } from '@apnacircle/types';

const activeCities = CITIES.filter((c) => c.active);
const upcomingCities = CITIES.filter((c) => !c.active);
---

<BaseLayout title={t('cities.pageTitle')} description={t('cities.pageLead')}>
  <header class="max-w-2xl">
    <h1 class="text-3xl font-bold tracking-tight text-[var(--ac-ink)] sm:text-4xl">
      {t('cities.pageTitle')}
    </h1>
    <p class="mt-3 text-base text-[var(--ac-ink-muted)]">{t('cities.pageLead')}</p>
  </header>

  <section class="mt-10" aria-labelledby="active-cities-heading">
    <h2 id="active-cities-heading" class="text-xl font-bold text-[var(--ac-ink)]">
      {t('cities.activeSectionTitle')}
    </h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      {
        activeCities.map((city) => (
          <article class="rounded-2xl border border-[var(--ac-border)] bg-[var(--ac-surface)] p-6 shadow-[var(--ac-shadow-card)]">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-xl font-semibold text-[var(--ac-ink)]">{city.name}</h3>
              <span class="rounded-full bg-[var(--ac-success-soft)] px-3 py-1 text-xs font-semibold text-[var(--ac-success)]">
                {t('cities.statusActive')}
              </span>
            </div>
            <p class="mt-1 text-sm text-[var(--ac-ink-muted)]">{city.state}</p>
            <div class="mt-5">
              <a
                href={`/${city.slug}`}
                class="inline-flex min-h-10 items-center rounded-xl bg-[var(--ac-accent)] px-4 py-2 text-sm font-semibold text-white hover:bg-[var(--ac-accent-hover)]"
              >
                {t('cities.exploreButton', { city: city.name })}
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="mt-12" aria-labelledby="upcoming-cities-heading">
    <h2 id="upcoming-cities-heading" class="text-xl font-bold text-[var(--ac-ink)]">
      {t('cities.upcomingSectionTitle')}
    </h2>
    <p class="mt-1 text-sm text-[var(--ac-ink-muted)]">{t('cities.upcomingNote')}</p>
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        upcomingCities.map((city) => (
          <article class="rounded-2xl border border-[var(--ac-border)] bg-[var(--ac-surface-muted)] p-5">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-base font-semibold text-[var(--ac-ink)]">{city.name}</h3>
              <span class="rounded-full border border-[var(--ac-border)] bg-[var(--ac-surface)] px-2.5 py-0.5 text-xs text-[var(--ac-ink-muted)]">
                {t('cities.statusPlanned', { order: city.rolloutOrder })}
              </span>
            </div>
            <p class="mt-1 text-xs text-[var(--ac-ink-muted)]">{city.state}</p>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
