---
import { getSecret } from 'astro:env/server';
import { t } from '@apnacircle/i18n';
import { ACTIVE_CITIES } from '@apnacircle/types';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ANALYTICS_COOKIE, analyticsCookieValue } from '../../lib/analytics.js';
import { readConnectionForm } from '../../lib/connection-requests.js';
import { completeOnboarding, getOnboarding, onboardingForm } from '../../lib/hosting.js';
import { ONBOARDING_PATH, PROFILE_AUTH_PATH, PROFILE_PATH, PROFILE_SESSION } from '../../lib/profile-editor.js';
import { getClientIp, getRuntimePublicApiConfig } from '../../lib/server-config.js';
import { verifyTurnstileToken } from '../../lib/turnstile.js';

export const prerender = false;
const key = getSecret('ONBOARDING_WRITE_KEY');
const token = Astro.cookies.get(PROFILE_SESSION)?.value;
const config = getRuntimePublicApiConfig();
const result = config && token ? await getOnboarding(config, token) : null;
const setup = result?.ok ? result.data : null;
if (setup?.state === 'complete') return Astro.redirect(PROFILE_PATH, 303);
const canTrack = Boolean(getSecret('POSTHOG_PROJECT_KEY')?.trim());
let blocked = setup?.age_locked || Astro.cookies.has('ac_age_block');
let error: 'invalid' | 'invite' | 'verification' | 'unavailable' | undefined;
if (Astro.request.method === 'POST' && setup?.state === 'new' && !blocked && config && token && key) {
  const form = await readConnectionForm(Astro.request, Astro.url.origin);
  if (form instanceof Response) return form;
  const parsed = onboardingForm.safeParse({
    displayName: form.get('displayName'), city: form.get('city'), dob: form.get('dob'),
    invite: form.get('invite') ?? '', interests: form.getAll('interests'),
    terms: form.has('terms'), guidelines: form.has('guidelines'), discovery: form.has('discovery'),
    cityVisible: form.has('cityVisible'), emailNotifications: form.has('emailNotifications'),
    analytics: canTrack && form.has('analytics'), turnstile: form.get('cf-turnstile-response'),
  });
  if (!parsed.success) error = 'invalid';
  else if (!(await verifyTurnstileToken(parsed.data.turnstile, getSecret('TURNSTILE_SECRET_KEY'), getClientIp(Astro))).success) {
    error = 'verification';
  } else {
    const response = await completeOnboarding(config, token, key, parsed.data, '1.0');
    if (response.ok && response.data === 'complete') {
      if (canTrack) Astro.cookies.set(ANALYTICS_COOKIE, analyticsCookieValue(parsed.data.analytics ? 'allow' : 'decline'), {
        httpOnly: true, secure: Astro.url.protocol === 'https:', sameSite: 'strict', path: '/', maxAge: 31_536_000,
      });
      return Astro.redirect(PROFILE_PATH, 303);
    }
    if (response.ok && response.data === 'age_locked') {
      blocked = true;
      Astro.cookies.set('ac_age_block', '1', { httpOnly: true, secure: Astro.url.protocol === 'https:', sameSite: 'lax', path: '/', maxAge: 86_400 });
    } else {
      error = response.ok ? 'invite' : response.status === 422 ? 'invalid' : 'unavailable';
    }
  }
}
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const signIn = PROFILE_AUTH_PATH + '?' + new URLSearchParams({ start: '1', returnTo: ONBOARDING_PATH });
const signedOut = !token || (result?.ok === false && result.status === 401);
if (signedOut) Astro.response.status = 401;
else if (blocked || setup?.state === 'unavailable') Astro.response.status = 403;
else if (!setup || !key || !siteKey) Astro.response.status = 503;
else if (error) Astro.response.status = error === 'unavailable' ? 503 : 422;
---

<BaseLayout title={t('onboard.title')} noindex>
  <section class="mx-auto max-w-2xl">
    <h1 class="text-3xl font-bold tracking-tight">{t('onboard.title')}</h1>
    {signedOut ? <a class="workspace-button mt-5" href={signIn}>{t('profile.signIn')}</a>
      : blocked ? <p class="mt-4" role="alert">{t('onboard.blocked')}</p>
      : !setup || setup.state !== 'new' || !key || !siteKey ? <p class="mt-4" role="alert">{t('onboard.unavailable')}</p>
      : (
        <>
          <p class="mt-2 text-[var(--ac-ink-muted)]">{t('onboard.intro')}</p>
          {error && <p role="alert" class="mt-4 text-sm font-semibold text-[var(--ac-danger)]">{t(`onboard.error.${error}`)}</p>}
          <form method="post" class="workspace-form mt-6">
            <label>{t('profile.displayName')}<input name="displayName" required minlength="2" maxlength="50" autocomplete="nickname" /></label>
            <div class="grid gap-4 sm:grid-cols-2">
              <label>{t('onboard.city')}<select name="city" required>{ACTIVE_CITIES.map((city) => <option value={city.slug}>{city.name}</option>)}</select></label>
              <label>{t('onboard.dob')}<input type="date" name="dob" required min="1900-01-01" autocomplete="bday" /></label>
            </div>
            {!setup.invited && <label>{t('onboard.invite')}<input name="invite" required maxlength="128" autocomplete="off" /></label>}
            <fieldset class="space-y-2">
              <legend class="mb-2 font-semibold">{t('onboard.interests')}</legend>
              <div class="grid gap-2 sm:grid-cols-2">
                {setup.interests.map((interest) => <label><input type="checkbox" name="interests" value={interest.id} /> {interest.name}</label>)}
              </div>
            </fieldset>
            <fieldset class="space-y-2">
              <legend class="mb-2 font-semibold">{t('onboard.choices')}</legend>
              <label><input type="checkbox" name="terms" required /> {t('onboard.acceptTerms')}</label>
              <p class="text-sm"><a class="underline" href="/terms" target="_blank" rel="noopener">{t('footer.termsLink')}</a> · <a class="underline" href="/privacy" target="_blank" rel="noopener">{t('footer.privacyLink')}</a></p>
              <label><input type="checkbox" name="guidelines" required /> {t('onboard.acceptGuidelines')}</label>
              <p class="text-sm"><a class="underline" href="/community-guidelines" target="_blank" rel="noopener">{t('footer.communityLink')}</a></p>
              <label><input type="checkbox" name="discovery" /> {t('profile.discovery')}</label>
              <label><input type="checkbox" name="cityVisible" /> {t('profile.cityVisible')}</label>
              <label><input type="checkbox" name="emailNotifications" /> {t('onboard.email')}</label>
              {canTrack && <label><input type="checkbox" name="analytics" /> {t('analytics.allow')}</label>}
            </fieldset>
            <div class="cf-turnstile" data-sitekey={siteKey}></div>
            <button class="workspace-button">{t('onboard.submit')}</button>
          </form>
          <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
        </>
      )}
  </section>
</BaseLayout>
