---
import { t } from '@apnacircle/i18n';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { feedbackInboxQuery, feedbackReviewForm, feedbackStatuses, formatFeedbackReference, getFeedback, listFeedback, reviewFeedback } from '../../../lib/feedback.js';
import { readConnectionForm } from '../../../lib/connection-requests.js';
import { formatMeetupWhen } from '../../../lib/meetups.js';
import { CONNECTION_ABUSE_PATH, FEEDBACK_INBOX_PATH, PROFILE_AUTH_PATH, PROFILE_SESSION } from '../../../lib/profile-editor.js';
import { getRuntimePublicApiConfig } from '../../../lib/server-config.js';

export const prerender = false;

const query = feedbackInboxQuery.safeParse({
  after: Astro.url.searchParams.get('after') ?? undefined,
  id: Astro.url.searchParams.get('id') ?? undefined,
  status: Astro.url.searchParams.get('status') ?? undefined,
});
if (!query.success) return new Response(null, { status: 400 });

const { after, id, status: filter } = query.data;
const token = Astro.cookies.get(PROFILE_SESSION)?.value;
const config = getRuntimePublicApiConfig();
function inboxHref(cursor?: string, selected?: string, updated = false) {
  const params = new URLSearchParams();
  if (filter !== 'all') params.set('status', filter);
  if (cursor) params.set('after', cursor);
  if (selected) params.set('id', selected);
  if (updated) params.set('updated', '1');
  return params.size ? `${FEEDBACK_INBOX_PATH}?${params}` : FEEDBACK_INBOX_PATH;
}

let reviewStatus: number | undefined;
if (Astro.request.method === 'POST') {
  const form = await readConnectionForm(Astro.request, Astro.url.origin);
  if (form instanceof Response) return form;
  if (!id) return new Response(null, { status: 400 });
  if (!token) return new Response(null, { status: 401 });
  if (!config) return new Response(null, { status: 503 });
  const parsed = feedbackReviewForm.safeParse({
    expected: form.get('expected'), decision: form.get('decision'), note: form.get('note') ?? '',
  });
  if (parsed.success) {
    const updated = await reviewFeedback(config, token, id, parsed.data);
    if (updated.ok) return Astro.redirect(inboxHref(after, id, true), 303);
    reviewStatus = updated.status;
  } else {
    reviewStatus = 422;
  }
} else if (!['GET', 'HEAD'].includes(Astro.request.method)) {
  return new Response(null, { status: 405, headers: { Allow: 'GET, HEAD, POST' } });
}

const detail = config && token && id ? await getFeedback(config, token, id) : null;
const queue = config && token && !id ? await listFeedback(config, token, query.data) : null;
const result = detail ?? queue;
const status = result?.ok ? 200 : result?.status ?? (token ? 503 : 401);
const responseStatus = status === 200 ? reviewStatus ?? status : status;
Astro.response.status = [200, 401, 403, 404, 409, 422, 428].includes(responseStatus) ? responseStatus : 503;
const signInHref = `${PROFILE_AUTH_PATH}?${new URLSearchParams({ start: '1', returnTo: FEEDBACK_INBOX_PATH })}`;
const item = detail?.ok ? detail.data : null;
const inbox = queue?.ok ? queue.data : null;
const saved = Astro.request.method === 'GET' && Astro.url.searchParams.get('updated') === '1';
const button = 'min-h-11 rounded-xl border border-[var(--ac-border-strong)] px-4 text-sm font-semibold hover:bg-[var(--ac-surface-muted)]';
const primary = 'min-h-11 rounded-xl bg-[var(--ac-accent)] px-4 text-sm font-semibold text-white hover:bg-[var(--ac-accent-hover)]';
const select = 'min-h-11 rounded-xl border border-[var(--ac-border-strong)] bg-[var(--ac-surface)] px-3 text-sm';
const link = 'inline-flex min-h-11 items-center text-sm font-semibold text-[var(--ac-accent)] underline underline-offset-4';
---

<BaseLayout title={t('feedbackInbox.title')} noindex={true}>
  <section class="mx-auto max-w-3xl">
    {id && <a href={inboxHref(after)} class={link}>{t('feedbackInbox.back')}</a>}
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{t('feedbackInbox.title')}</h1>

    {status === 401 ? (
      <a href={signInHref} class:list={[link, 'mt-3']}>{t('profile.signIn')}</a>
    ) : status === 403 ? (
      <p class="mt-4 text-sm">{t('feedbackInbox.forbidden')}</p>
    ) : status === 428 ? (
      <a href={CONNECTION_ABUSE_PATH} class:list={[link, 'mt-3']}>{t('feedbackInbox.verify')}</a>
    ) : item ? (
      <>
      {saved && <p role="status" class="mt-4 text-sm font-semibold text-[var(--ac-success)]">{t('feedbackInbox.saved')}</p>}
      {reviewStatus && <p role="alert" class="mt-4 text-sm">{t(reviewStatus === 409 ? 'feedbackInbox.changed' : reviewStatus === 422 ? 'feedbackInbox.invalidReview' : 'feedbackInbox.unavailable')}</p>}
      <article class="mt-6 rounded-xl border border-[var(--ac-border)] bg-[var(--ac-surface)] p-4 sm:p-6">
        <p class="text-sm text-[var(--ac-ink-muted)]">{t(`feedback.category.${item.category}`)} · <time datetime={item.created_at}>{formatMeetupWhen(item.created_at, null)}</time></p>
        <h2 class="mt-1 break-words text-xl font-semibold">{item.subject}</h2>
        <p class="mt-2 text-sm font-semibold text-[var(--ac-accent)]">{t(`feedbackInbox.status.${item.status}`)}</p>
        <p class="mt-4 whitespace-pre-wrap break-words text-sm leading-relaxed">{item.message}</p>
        <dl class="mt-5 space-y-3 border-t border-[var(--ac-border)] pt-4 text-sm">
          <div>
            <dt class="font-semibold">{t('feedbackInbox.reference')}</dt>
            <dd class="break-all text-[var(--ac-ink-muted)]">{formatFeedbackReference(item.id)}</dd>
          </div>
          {item.contact_email && <div>
            <dt class="font-semibold">{t('feedbackInbox.replyEmail')}</dt>
            <dd class="break-all text-[var(--ac-ink-muted)]">{item.contact_email}</dd>
          </div>}
        </dl>
      </article>
      {(item.status === 'new' || item.status === 'triaged') && (
        <form method="post" action={inboxHref(after, item.id)} class="mt-5 space-y-3">
          <input type="hidden" name="expected" value={item.status} />
          {item.status === 'new' ? (
            <button class={primary} name="decision" value="start">{t('feedbackInbox.action.start')}</button>
          ) : (
            <>
              <label class="block text-sm font-semibold" for="feedback-review-note">{t('feedbackInbox.note')}</label>
              <textarea id="feedback-review-note" name="note" rows="3" maxlength="1000" required class="w-full rounded-xl border border-[var(--ac-border-strong)] bg-[var(--ac-surface)] p-3 text-sm"></textarea>
              <div class="flex flex-wrap gap-2">
                <button class={primary} name="decision" value="approve">{t('feedbackInbox.action.approve')}</button>
                <button class={button} name="decision" value="dismiss">{t('feedbackInbox.action.dismiss')}</button>
              </div>
            </>
          )}
        </form>
      )}
      {!!item.reviews.length && (
        <section class="mt-7">
          <h2 class="font-semibold">{t('feedbackInbox.history')}</h2>
          <ol class="mt-2 divide-y divide-[var(--ac-border)] border-y border-[var(--ac-border)]">
            {item.reviews.map((review) => <li class="py-3 text-sm">
              <p class="font-semibold">{t(`feedbackInbox.history.${review.action}`)}</p>
              <p class="text-[var(--ac-ink-muted)]">{review.reviewer_name && `${review.reviewer_name} · `}<time datetime={review.created_at}>{formatMeetupWhen(review.created_at, null)}</time></p>
              {review.reason && <p class="mt-1 whitespace-pre-wrap break-words">{review.reason}</p>}
            </li>)}
          </ol>
        </section>
      )}
      </>
    ) : inbox ? (
      <>
      <form method="get" action={FEEDBACK_INBOX_PATH} class="mt-4 flex flex-wrap items-end gap-2">
        <label class="grid gap-1 text-sm font-semibold">
          {t('feedbackInbox.filter')}
          <select name="status" class={select}>
            {(['all', ...feedbackStatuses] as const).map((option) => (
              <option value={option} selected={option === filter}>{t(`feedbackInbox.status.${option}`)}</option>
            ))}
          </select>
        </label>
        <button class={button}>{t('feedbackInbox.applyFilter')}</button>
      </form>
      {inbox.items.length ? (
        <>
          <ul class="mt-6 divide-y divide-[var(--ac-border)] border-y border-[var(--ac-border)]">
            {inbox.items.map((feedback) => (
              <li>
                <a href={inboxHref(after, feedback.id)} class="block px-2 py-3 hover:bg-[var(--ac-surface-muted)] focus-visible:outline-2 focus-visible:outline-offset-2 sm:px-3">
                  <p class="break-words text-sm font-semibold">{feedback.subject}</p>
                  <p class="mt-1 text-sm text-[var(--ac-ink-muted)]">
                    {t(`feedbackInbox.status.${feedback.status}`)} · {t(`feedback.category.${feedback.category}`)} · <time datetime={feedback.created_at}>{formatMeetupWhen(feedback.created_at, null)}</time>
                  </p>
                </a>
              </li>
            ))}
          </ul>
          {inbox.nextCursor && <a href={inboxHref(inbox.nextCursor)} class:list={[link, 'mt-3']}>{t('feedbackInbox.older')}</a>}
          {after && <a href={inboxHref()} class:list={[link, 'mt-3 ml-5']}>{t('feedbackInbox.newest')}</a>}
        </>
      ) : <p class="mt-4 text-sm">{t('feedbackInbox.empty')}</p>}
      </>
    ) : (
      <p role="alert" class="mt-4 text-sm">{t(status === 404 ? 'feedbackInbox.missing' : 'feedbackInbox.unavailable')}</p>
    )}
  </section>
</BaseLayout>
