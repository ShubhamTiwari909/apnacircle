---
import { t } from '@apnacircle/i18n';
import { z } from 'zod';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { authenticatedRequest } from '../../../lib/connection-abuse.js';
import { readConnectionForm } from '../../../lib/connection-requests.js';
import { PROFILE_AUTH_PATH, PROFILE_SESSION, STAFF_AUTH_PATH } from '../../../lib/profile-editor.js';
import { fetchSignedProfilePhotoUrls, PROFILE_MEDIA_PATH } from '../../../lib/profile-photo-links.js';
import { getRuntimePublicApiConfig } from '../../../lib/server-config.js';

export const prerender = false;
const path = '/me/moderation/photos';
const token = Astro.cookies.get(PROFILE_SESSION)?.value;
const config = getRuntimePublicApiConfig();
const rows = z.array(z.object({ id: z.guid(), screening_result: z.enum(['clear','flagged']),
  hash_match: z.enum(['exact','near']).nullable() })).max(20);
const review = z.object({
  id: z.guid(), choice: z.enum(['approve','reject']), note: z.string().trim().min(10).max(1000),
});
let error = false;
if (Astro.request.method === 'POST' && config && token) {
  const form = await readConnectionForm(Astro.request, Astro.url.origin);
  if (form instanceof Response) return form;
  const parsed = review.safeParse(Object.fromEntries(form));
  if (parsed.success) {
    const { id, choice, note } = parsed.data;
    const result = await authenticatedRequest(config, token, '/rest/v1/rpc/review_profile_photo', async () => null,
      { p_id: id, p_approve: choice === 'approve', p_reason: note });
    if (result.ok) return Astro.redirect(path, 303);
    Astro.response.status = result.status;
  } else Astro.response.status = 422;
  error = true;
}
const result = config && token ? await authenticatedRequest(config, token, '/rest/v1/rpc/list_profile_photo_review',
  async (response) => rows.parse(await response.json()), { p_limit: 20 }) : null;
const photos = result?.ok ? result.data : null;
const signIn = !token || result?.ok === false && result.status === 401;
const links = config && token && photos?.length ?
  await fetchSignedProfilePhotoUrls(config, token, photos.map(({ id }) => id), 'display', fetch, true) : new Map<string,string>();
const signInHref = PROFILE_AUTH_PATH + '?' + new URLSearchParams({start:'1',returnTo:path});
if (!error && !photos) Astro.response.status = signIn ? 401 : result?.ok === false ? result.status : 503;
---

<BaseLayout title={t('photoReview.title')} noindex>
  <section class="mx-auto max-w-2xl">
    <a href="/me/moderation/feedback" class="workspace-link">{t('feedbackInbox.title')}</a>
    <h1 class="text-3xl font-bold tracking-tight">{t('photoReview.title')}</h1>
    {signIn ? <a href={signInHref} class="workspace-button mt-4">{t('profile.signIn')}</a>
      : !photos ? <p class="mt-4" role="alert">{t('photoReview.unavailable')} <a href={STAFF_AUTH_PATH + '?' + new URLSearchParams({returnTo:path})} class="workspace-link">{t('feedbackInbox.verify')}</a></p>
      : (
        <>
          {error && <p class="mt-4 text-[var(--ac-danger)]" role="alert">{t('photoReview.saveError')}</p>}
          {!photos.length && <p class="mt-4 text-[var(--ac-ink-muted)]">{t('photoReview.empty')}</p>}
          <ul class="mt-4 space-y-4">
            {photos.map((photo) => {
              const image = links.get(photo.id);
              return <li class="workspace-panel">
                <p class="text-sm font-semibold">{t(`photoReview.${photo.screening_result}`)}</p>
                {photo.hash_match && <p class="mt-1 text-sm">{t('photoReview.hashMatch')}</p>}
                {image ? <img src={PROFILE_MEDIA_PATH + image} alt={t('photoReview.image')} width="480" height="480" class="mt-3 h-auto w-full max-w-sm rounded-xl" />
                  : <p class="mt-2 text-sm">{t('photoReview.imageUnavailable')}</p>}
                <form method="post" class="mt-4 space-y-3">
                  <input type="hidden" name="id" value={photo.id} />
                  <label class="block text-sm font-semibold">{t('photoReview.note')}<textarea name="note" required minlength="10" maxlength="1000" class="mt-1 block w-full rounded-xl border border-[var(--ac-border)] p-2"></textarea></label>
                  <div class="flex flex-wrap gap-3">
                    {image && !photo.hash_match && <button class="workspace-button" name="choice" value="approve">{t('participation.approve')}</button>}
                    <button class="workspace-secondary" name="choice" value="reject">{t('photoReview.reject')}</button>
                  </div>
                </form>
              </li>;
            })}
          </ul>
        </>
      )}
  </section>
</BaseLayout>
