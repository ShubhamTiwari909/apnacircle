---
import { t } from '@apnacircle/i18n';
import { ACTIVE_CITIES, CATEGORIES } from '@apnacircle/types';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { readConnectionForm } from '../../../../lib/connection-requests.js';
import { createMeetup, getHostWorkspace, meetupForm } from '../../../../lib/hosting.js';
import { CREATE_MEETUP_PATH, HOST_PATH, PROFILE_AUTH_PATH, PROFILE_SESSION } from '../../../../lib/profile-editor.js';
import { getRuntimePublicApiConfig } from '../../../../lib/server-config.js';

export const prerender = false;
const token = Astro.cookies.get(PROFILE_SESSION)?.value;
const config = getRuntimePublicApiConfig();
const result = config && token ? await getHostWorkspace(config, token) : null;
const host = result?.ok ? result.data : null;
const needsSignIn = !token || (result?.ok === false && result.status === 401);
const signIn = PROFILE_AUTH_PATH + '?' + new URLSearchParams({ start: '1', returnTo: CREATE_MEETUP_PATH });
let form: FormData | undefined;
let error = false;
if (Astro.request.method === 'POST' && config && token && host?.host_status === 'approved') {
  const body = await readConnectionForm(Astro.request, Astro.url.origin);
  if (body instanceof Response) return body;
  form = body;
  const parsed = meetupForm.safeParse({
    ...Object.fromEntries(body), publicVenue: body.has('publicVenue'), womenOnly: body.has('womenOnly'),
  });
  if (parsed.success) {
    const response = await createMeetup(config, token, parsed.data);
    if (response.ok) return Astro.redirect(HOST_PATH, 303);
    Astro.response.status = response.status;
  } else Astro.response.status = 422;
  error = true;
} else if (host?.host_status !== 'approved') Astro.response.status = needsSignIn ? 401 : result && !result.ok ? result.status : 403;
const value = (name: string) => String(form?.get(name) ?? '');
---

<BaseLayout title={t('host.create')} noindex>
  <section class="mx-auto max-w-2xl">
    <a class="workspace-link" href={HOST_PATH}>{t('host.title')}</a>
    <h1 class="text-3xl font-bold tracking-tight">{t('host.create')}</h1>
    {needsSignIn ? <a class="workspace-button mt-5" href={signIn}>{t('profile.signIn')}</a>
      : host?.host_status !== 'approved' ? <p class="mt-4">{t('host.approvalRequired')}</p>
      : (
        <>
          <p class="mt-2 text-[var(--ac-ink-muted)]">{t(host.established ? 'host.establishedRule' : 'host.reviewRule')}</p>
          {error && <p role="alert" class="mt-4 text-sm font-semibold text-[var(--ac-danger)]">{t('host.meetupError')}</p>}
          <form method="post" class="workspace-form mt-6">
            <div class="grid gap-4 sm:grid-cols-2">
              <label>{t('onboard.city')}<select name="city" required>{ACTIVE_CITIES.map((city) => <option value={city.slug} selected={value('city') === city.slug}>{city.name}</option>)}</select></label>
              <label>{t('feedback.categoryLabel')}<select name="category" required>{CATEGORIES.filter(({kind}) => kind === 'activity').map((category) => <option value={category.slug} selected={value('category') === category.slug}>{category.name}</option>)}</select></label>
            </div>
            <label>{t('host.meetupTitle')}<input name="title" required minlength="5" maxlength="120" value={value('title')} /></label>
            <label>{t('feedback.descriptionLabel')}<textarea name="description" rows="4" minlength="20" maxlength="4000" required>{value('description')}</textarea></label>
            <div class="grid gap-4 sm:grid-cols-2">
              <label>{t('host.venue')}<input name="venue" required minlength="3" maxlength="120" value={value('venue')} /></label>
              <label>{t('host.locality')}<input name="locality" required minlength="2" maxlength="80" value={value('locality')} /></label>
            </div>
            <label>{t('host.spot')}<input name="spot" maxlength="300" value={value('spot')} /></label>
            <div class="grid gap-4 sm:grid-cols-2">
              <label>{t('host.start')}<input type="datetime-local" name="starts" required value={value('starts')} /></label>
              <label>{t('host.end')}<input type="datetime-local" name="ends" required value={value('ends')} /></label>
              <label>{t('host.capacity')}<input type="number" name="capacity" required min="2" max={host.established ? 50 : 15} value={value('capacity') || '10'} /></label>
              <label>{t('host.joinMode')}<select name="joinMode"><option value="auto">{t('host.joinAuto')}</option><option value="approval" selected={value('joinMode') === 'approval'}>{t('host.joinApproval')}</option></select></label>
            </div>
            <label><input type="checkbox" name="womenOnly" checked={form?.has('womenOnly')} /> {t('meetups.womenOnlyBadge')}</label>
            <label><input type="checkbox" name="publicVenue" required checked={form?.has('publicVenue')} /> {t('host.confirmPublic')}</label>
            <button class="workspace-button">{t('host.submitMeetup')}</button>
          </form>
        </>
      )}
  </section>
</BaseLayout>
