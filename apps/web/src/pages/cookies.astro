---
import AnalyticsPreferences from '../components/AnalyticsPreferences.astro';
import PolicyDocument from '../components/PolicyDocument.astro';
import { t } from '@apnacircle/i18n';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<PolicyDocument
  policyId="07-cookie-and-analytics-notice"
  pageTitle={t('footer.cookiesLink')}
  description="Information on essential cookies, local storage, and consent-gated analytics."
>
  <div slot="preferences" id="analytics">
    <AnalyticsPreferences returnTo="/cookies#analytics" />
  </div>
</PolicyDocument>
