---
import BaseLayout from '../layouts/BaseLayout.astro';
import MeetupListing from '../components/MeetupListing.astro';
import { t } from '@apnacircle/i18n';
import { CATEGORIES } from '@apnacircle/types';
import { getPublicApiConfig, listPublicMeetups, parseListingQuery } from '../lib/meetups.js';

// Dynamic (plan 7.5): rendered per request, shared-cache for 60 seconds.
export const prerender = false;


const query = parseListingQuery(
  Astro.url.searchParams,
  null,
  CATEGORIES.map((c) => c.slug),
);
const config = getPublicApiConfig({ ...import.meta.env, ...(Astro.locals.runtime?.env ?? {}) });
const result = config ? await listPublicMeetups(config, query) : ({ ok: false } as const);

// Never cache or index an outage: 503 + no-store. Healthy pages are shared-cached for 60 seconds (plan 7.5).
if (result.ok) {
  Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=30');
} else {
  Astro.response.status = 503;
  Astro.response.headers.set('Cache-Control', 'no-store');
}

const isFiltered = query.categorySlug !== null || query.when !== 'any';
const nextCursor = result.ok ? result.data.nextCursor : null;
const nextParams = new URLSearchParams();
if (query.categorySlug) nextParams.set('category', query.categorySlug);
if (query.when !== 'any') nextParams.set('when', query.when);
if (nextCursor) nextParams.set('after', nextCursor);
const nextHref = nextCursor ? `/meetups?${nextParams.toString()}` : null;
---

<BaseLayout
  title={t('meetups.pageTitle')}
  description={t('meetups.pageLead')}
  canonicalPath="/meetups"
  noindex={isFiltered || query.cursor !== null}
>
  <header class="max-w-3xl">
    <div class="flex flex-wrap gap-2">
      <span class="rounded-full bg-[var(--ac-accent-soft)] px-3 py-1 text-xs font-semibold text-[var(--ac-accent)]">
        {t('meetups.publicVenueBadge')}
      </span>
      <span class="rounded-full bg-[var(--ac-warm-soft)] px-3 py-1 text-xs font-semibold text-[var(--ac-warm)]">
        {t('meetups.ageGateBadge')}
      </span>
    </div>
    <h1 class="mt-4 text-3xl font-bold tracking-tight text-[var(--ac-ink)] sm:text-4xl">
      {t('meetups.pageTitle')}
    </h1>
    <p class="mt-3 text-base text-[var(--ac-ink-muted)]">{t('meetups.pageLead')}</p>
  </header>

  <MeetupListing
    basePath="/meetups"
    state={result.ok ? 'ok' : 'unavailable'}
    meetups={result.ok ? result.data.meetups : []}
    nextHref={nextHref}
    category={query.categorySlug}
    when={query.when}
    isFiltered={isFiltered}
  />
</BaseLayout>
