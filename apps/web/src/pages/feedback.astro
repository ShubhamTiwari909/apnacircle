---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '@apnacircle/i18n';
import { FeedbackForm } from '../components/FeedbackForm.js';

const turnstileSiteKey =
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '1x00000000000000000000AA';
---

<BaseLayout title={t('feedback.pageTitle')} description={t('feedback.pageLead')}>
  <div class="mx-auto max-w-2xl">
    <header>
      <h1 class="text-3xl font-bold tracking-tight text-[var(--ac-ink)] sm:text-4xl">
        {t('feedback.pageTitle')}
      </h1>
      <p class="mt-3 text-base text-[var(--ac-ink-muted)]">{t('feedback.pageLead')}</p>
    </header>

    <section class="mt-8 rounded-3xl border border-[var(--ac-border)] bg-[var(--ac-surface)] p-6 shadow-[var(--ac-shadow-card)] sm:p-8">
      <FeedbackForm client:load turnstileSiteKey={turnstileSiteKey} />
    </section>

    <aside class="mt-6 rounded-2xl border border-[var(--ac-border)] bg-[var(--ac-warm-soft)] p-5">
      <h2 class="text-sm font-bold text-[var(--ac-ink)]">{t('feedback.safetyCalloutTitle')}</h2>
      <p class="mt-1 text-xs leading-relaxed text-[var(--ac-ink-muted)]">
        {t('feedback.safetyCalloutBody')}
      </p>
      <div class="mt-3 flex flex-wrap gap-4 text-xs font-semibold">
        <a href="/safety" class="text-[var(--ac-warm)] underline-offset-4 hover:underline">
          {t('footer.safetyLink')}
        </a>
        <a href="/grievance" class="text-[var(--ac-warm)] underline-offset-4 hover:underline">
          {t('footer.grievanceLink')}
        </a>
      </div>
    </aside>
  </div>
</BaseLayout>
