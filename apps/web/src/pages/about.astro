---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '@apnacircle/i18n';
---

<BaseLayout title={t('about.pageTitle')} description={t('about.pageLead')}>
  <article class="max-w-3xl">
    <h1 class="text-3xl font-bold tracking-tight text-[var(--ac-ink)] sm:text-4xl">
      {t('about.pageTitle')}
    </h1>
    <p class="mt-3 text-base leading-relaxed text-[var(--ac-ink-muted)]">
      {t('about.pageLead')}
    </p>

    <h2 class="mt-10 text-xl font-bold text-[var(--ac-ink)]">{t('about.principlesTitle')}</h2>
    <div class="mt-4 space-y-4">
      <section class="rounded-2xl border border-[var(--ac-border)] bg-[var(--ac-surface)] p-6 shadow-[var(--ac-shadow-card)]">
        <h3 class="text-base font-semibold text-[var(--ac-ink)]">{t('about.principle1Title')}</h3>
        <p class="mt-2 text-sm text-[var(--ac-ink-muted)]">{t('about.principle1Body')}</p>
      </section>
      <section class="rounded-2xl border border-[var(--ac-border)] bg-[var(--ac-surface)] p-6 shadow-[var(--ac-shadow-card)]">
        <h3 class="text-base font-semibold text-[var(--ac-ink)]">{t('about.principle2Title')}</h3>
        <p class="mt-2 text-sm text-[var(--ac-ink-muted)]">{t('about.principle2Body')}</p>
      </section>
      <section class="rounded-2xl border border-[var(--ac-border)] bg-[var(--ac-surface)] p-6 shadow-[var(--ac-shadow-card)]">
        <h3 class="text-base font-semibold text-[var(--ac-ink)]">{t('about.principle3Title')}</h3>
        <p class="mt-2 text-sm text-[var(--ac-ink-muted)]">{t('about.principle3Body')}</p>
      </section>
    </div>

    <div class="mt-8">
      <a
        href="/safety"
        class="text-sm font-semibold text-[var(--ac-accent)] underline-offset-4 hover:underline"
      >
        {t('policy.directoryLink')} &rarr;
      </a>
    </div>
  </article>
</BaseLayout>
