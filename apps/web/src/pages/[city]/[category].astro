---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { placePath, publishedPlaces } from '../../lib/editorial.js';
import { t } from '@apnacircle/i18n';
import { ACTIVE_CITIES, CATEGORIES, getCategoryBySlug } from '@apnacircle/types';
import { EmptyStateCard, PlaceCard } from '@apnacircle/ui';

export function getStaticPaths() {
  return ACTIVE_CITIES.flatMap((cityMeta) =>
    CATEGORIES.map((categoryMeta) => ({
      params: { city: cityMeta.slug, category: categoryMeta.slug },
      props: { cityMeta, categoryMeta },
    })),
  );
}

const { cityMeta, categoryMeta } = Astro.props;

const categoryDocs = await getCollection(
  'categories',
  ({ data }) =>
    data.status === 'published' &&
    data.citySlug === cityMeta.slug &&
    data.slug === categoryMeta.slug,
);
const categoryDoc = categoryDocs[0];
const Content = categoryDoc ? (await render(categoryDoc)).Content : null;

const places = (await publishedPlaces(cityMeta.slug)).filter(({ data }) => data.categorySlug === categoryMeta.slug);

const pageTitle = categoryDoc?.data.title ?? `${categoryMeta.name} in ${cityMeta.name}`;
const pageDescription =
  categoryDoc?.data.summary ??
  `Curated ${categoryMeta.name.toLowerCase()} in ${cityMeta.name}, verified before publication.`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  activeCitySlug={cityMeta.slug}
  noindex={!categoryDoc && !places.length}
  breadcrumbs={[{ label: t('nav.cities'), path: '/cities' }, { label: cityMeta.name, path: `/${cityMeta.slug}` }, { label: categoryMeta.name }]}
>
  <header class="max-w-3xl">
    <h1 class="text-3xl font-bold tracking-tight text-[var(--ac-ink)] sm:text-4xl">
      {pageTitle}
    </h1>
    <p class="mt-3 text-base text-[var(--ac-ink-muted)]">{pageDescription}</p>
  </header>

  {Content && <div class="article-body mt-5 max-w-3xl text-sm leading-relaxed"><Content /></div>}

  <section class="mt-8">
    {
      places.length > 0 ? (
        <div class="grid gap-5 sm:grid-cols-2">
          {places.map((place) => {
            const cat = getCategoryBySlug(place.data.categorySlug);
            return (
              <PlaceCard
                name={place.data.name}
                locality={place.data.locality}
                categoryLabel={cat?.name ?? categoryMeta.name}
                summary={place.data.summary}
                publicAccessNote={place.data.publicAccessNote}
                lastVerifiedAt={t('article.verifiedOn', { date: place.data.lastVerifiedAt })}
                href={placePath(cityMeta.slug, place.id)}
              />
            );
          })}
        </div>
      ) : (
        <EmptyStateCard
          title={t('category.emptyTitle')}
          description={t('category.emptyBody')}
          actions={[
            { href: '/feedback', label: t('category.suggestSpot'), variant: 'primary' },
          ]}
        />
      )
    }
  </section>
</BaseLayout>
