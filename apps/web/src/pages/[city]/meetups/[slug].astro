---
import { getRuntimePublicApiConfig } from '../../../lib/server-config.js';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '@apnacircle/i18n';
import { ACTIVE_CITIES } from '@apnacircle/types';
import { ErrorStateCard } from '@apnacircle/ui';
import {
  buildEventJsonLd,
  formatMeetupWhen,
  getPublicMeetup,
  isCurrentPublicMeetup,
  isFull,
  spotsLeft,
} from '../../../lib/meetups.js';

// Canonical meetup URL: /<city>/meetups/<slug> (plan 10). Dynamic, shared-cache for 60 seconds.
export const prerender = false;

const cityMeta = ACTIVE_CITIES.find((c) => c.slug === Astro.params.city);
const slug = Astro.params.slug ?? '';
if (!cityMeta || !/^[a-z0-9-]{1,80}$/.test(slug)) {
  return Astro.rewrite('/404');
}

const config = getRuntimePublicApiConfig();
const result = config ? await getPublicMeetup(config, cityMeta.slug, slug) : ({ ok: false } as const);

if (result.ok && result.data === null) {
  return Astro.rewrite('/404');
}


// Never cache or index an outage: 503 + no-store. Healthy pages are shared-cached for 60 seconds (plan 7.5).
if (result.ok) {
  Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=30');
} else {
  Astro.response.status = 503;
  Astro.response.headers.set('Cache-Control', 'no-store');
}

const meetup = result.ok ? result.data : null;
const cancelled = meetup?.status === 'cancelled';
const current = meetup !== null && isCurrentPublicMeetup(meetup);
const jsonLd = meetup && Astro.site ? buildEventJsonLd(meetup, Astro.site.origin) : null;
const listPath = `/${cityMeta.slug}/meetups`;
---

<BaseLayout
  title={meetup ? meetup.title : t('meetups.unavailableTitle')}
  description={meetup ? meetup.description.replace(/\s+/g, ' ').trim().slice(0, 160) : t('meetups.unavailableBody')}
  activeCitySlug={cityMeta.slug}
  noindex={!current}
  structuredData={jsonLd}
  breadcrumbs={[{ label: t('nav.cities'), path: '/cities' }, { label: cityMeta.name, path: `/${cityMeta.slug}` }, { label: t('nav.meetups'), path: listPath }, { label: meetup?.title ?? t('meetups.unavailableTitle') }]}
>
  {!meetup ? (
    <ErrorStateCard title={t('meetups.unavailableTitle')} description={t('meetups.unavailableBody')} />
  ) : (
    <article class="max-w-3xl">
      <div class="flex flex-wrap gap-2">
        <span class="rounded-full bg-[var(--ac-warm-soft)] px-3 py-1 text-xs font-semibold text-[var(--ac-warm)]">{meetup.category_name}</span>
        <span class="rounded-full bg-[var(--ac-accent-soft)] px-3 py-1 text-xs font-semibold text-[var(--ac-accent)]">{t('meetups.publicVenueBadge')}</span>
        {meetup.women_only ? (
          <span class="rounded-full bg-[var(--ac-accent-soft)] px-3 py-1 text-xs font-semibold text-[var(--ac-accent)]">{t('meetups.womenOnlyBadge')}</span>
        ) : null}
        {meetup.join_mode === 'approval' ? (
          <span class="rounded-full bg-[var(--ac-surface-muted)] px-3 py-1 text-xs font-semibold text-[var(--ac-ink)]">{t('meetups.approvalBadge')}</span>
        ) : null}
      </div>

      <h1 class="mt-4 text-3xl font-bold tracking-tight text-[var(--ac-ink)] sm:text-4xl">{meetup.title}</h1>
      <p class="mt-2 text-sm text-[var(--ac-ink-muted)]">{t('meetups.detail.hostedBy', { host: meetup.host_display_name })}</p>

      {cancelled ? (
        <div role="alert" class="mt-6 rounded-2xl border border-[var(--ac-danger)]/30 bg-[var(--ac-danger-soft)] p-5 text-[var(--ac-danger)]">
          <p class="font-semibold">{t('meetups.detail.cancelledTitle')}</p>
        </div>
      ) : null}

      <dl class="mt-6 grid gap-4 rounded-2xl border border-[var(--ac-border)] bg-[var(--ac-surface)] p-5 sm:grid-cols-3">
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-[var(--ac-ink-muted)]">{t('meetups.detail.whenLabel')}</dt>
          <dd class="mt-1 text-sm text-[var(--ac-ink)]">{formatMeetupWhen(meetup.starts_at, meetup.ends_at)}</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-[var(--ac-ink-muted)]">{t('meetups.detail.whereLabel')}</dt>
          <dd class="mt-1 text-sm text-[var(--ac-ink)]">{meetup.venue_name}, {meetup.locality}</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-[var(--ac-ink-muted)]">{t('meetups.detail.capacityLabel')}</dt>
          <dd class="mt-1 text-sm text-[var(--ac-ink)]">
            {t('meetups.detail.capacityValue', { going: meetup.attendee_count, capacity: meetup.capacity })}
            {!cancelled ? (isFull(meetup) ? ` · ${t('meetups.statusFull')}` : ` · ${t('meetups.spotsLeft', { count: spotsLeft(meetup) })}`) : ''}
          </dd>
        </div>
      </dl>

      <p class="mt-3 text-sm text-[var(--ac-ink-muted)]">{t('meetups.detail.venueNote', { locality: meetup.locality })}</p>

      <div class="mt-6 whitespace-pre-line text-base leading-relaxed text-[var(--ac-ink)]">{meetup.description}</div>

      {!cancelled ? (
        <section class="mt-8 rounded-2xl border border-[var(--ac-border)] bg-[var(--ac-surface)] p-5">
          <h2 class="text-lg font-semibold text-[var(--ac-ink)]">{t('meetups.detail.joinTitle')}</h2>
          <p class="mt-2 text-sm text-[var(--ac-ink-muted)]">{t('meetups.detail.joinBody')}</p>
        </section>
      ) : null}

      <section class="mt-6 rounded-2xl border border-[var(--ac-border)] bg-[var(--ac-bg)] p-5">
        <h2 class="text-lg font-semibold text-[var(--ac-ink)]">{t('meetups.detail.safetyTitle')}</h2>
        <p class="mt-2 text-sm text-[var(--ac-ink-muted)]">{t('meetups.detail.safetyBody')}</p>
        <p class="mt-3 flex flex-wrap gap-4 text-sm font-medium">
          <a href="/safety" class="text-[var(--ac-accent)] underline-offset-4 hover:underline">{t('meetups.detail.safetyLink')}</a>
          <a href="/grievance" class="text-[var(--ac-accent)] underline-offset-4 hover:underline">{t('meetups.detail.reportLink')}</a>
          <a href="/host-guidelines" class="text-[var(--ac-accent)] underline-offset-4 hover:underline">{t('footer.hostLink')}</a>
        </p>
      </section>
    </article>
  )}
</BaseLayout>
