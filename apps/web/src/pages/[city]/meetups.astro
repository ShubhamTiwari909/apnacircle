---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '@apnacircle/i18n';
import { ACTIVE_CITIES } from '@apnacircle/types';
import { EmptyStateCard } from '@apnacircle/ui';

export function getStaticPaths() {
  return ACTIVE_CITIES.map((cityMeta) => ({
    params: { city: cityMeta.slug },
    props: { cityMeta },
  }));
}

const { cityMeta } = Astro.props;
---

<BaseLayout
  title={`${t('meetups.pageTitle')} · ${cityMeta.name}`}
  description={t('meetups.pageLead')}
  activeCitySlug={cityMeta.slug}
>
  <nav aria-label="Breadcrumb" class="mb-4 text-xs text-[var(--ac-ink-muted)]">
    <a href="/cities" class="hover:text-[var(--ac-accent)]">{t('city.breadcrumbCities')}</a>
    <span aria-hidden="true" class="mx-1.5">/</span>
    <a href={`/${cityMeta.slug}`} class="hover:text-[var(--ac-accent)]">{cityMeta.name}</a>
    <span aria-hidden="true" class="mx-1.5">/</span>
    <span class="font-medium text-[var(--ac-ink)]">{t('nav.meetups')}</span>
  </nav>

  <header class="max-w-3xl">
    <div class="flex flex-wrap gap-2">
      <span class="rounded-full bg-[var(--ac-accent-soft)] px-3 py-1 text-xs font-semibold text-[var(--ac-accent)]">
        {t('meetups.publicVenueBadge')}
      </span>
      <span class="rounded-full bg-[var(--ac-warm-soft)] px-3 py-1 text-xs font-semibold text-[var(--ac-warm)]">
        {t('meetups.ageGateBadge')}
      </span>
    </div>
    <h1 class="mt-4 text-3xl font-bold tracking-tight text-[var(--ac-ink)] sm:text-4xl">
      {t('meetups.pageTitle')} — {cityMeta.name}
    </h1>
    <p class="mt-3 text-base text-[var(--ac-ink-muted)]">{t('meetups.pageLead')}</p>
  </header>

  <section class="mt-8">
    <EmptyStateCard
      title={t('meetups.emptyTitle')}
      description={t('meetups.emptyBody')}
      actions={[
        { href: '/safety', label: t('footer.safetyLink'), variant: 'primary' },
        { href: '/host-guidelines', label: t('footer.hostLink'), variant: 'secondary' },
      ]}
    />
  </section>
</BaseLayout>
