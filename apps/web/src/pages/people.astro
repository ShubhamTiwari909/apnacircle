---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '@apnacircle/i18n';

export const prerender = false;
---

<BaseLayout title={t('people.pageTitle')} noindex={true}>
  <section class="mx-auto max-w-2xl rounded-3xl border border-[var(--ac-border)] bg-[var(--ac-surface)] p-6 shadow-[var(--ac-shadow-card)] sm:p-10">
    <span class="inline-flex rounded-full bg-[var(--ac-accent-soft)] px-3 py-1 text-xs font-semibold text-[var(--ac-accent)]">
      {t('people.noindexNotice')}
    </span>
    <h1 class="mt-4 text-2xl font-bold text-[var(--ac-ink)] sm:text-3xl">
      {t('people.teaserTitle')}
    </h1>
    <p class="mt-3 text-sm leading-relaxed text-[var(--ac-ink-muted)] sm:text-base">
      {t('people.teaserBody')}
    </p>

    <div class="mt-6 rounded-2xl border border-[var(--ac-border)] bg-[var(--ac-bg)] p-5">
      <h2 class="text-sm font-semibold text-[var(--ac-ink)]">
        {t('people.teaserStatsHeading')}
      </h2>
      <ul class="mt-2 space-y-1.5 text-sm text-[var(--ac-ink-muted)]">
        <li>{t('people.teaserRoundedMembers')}</li>
        <li>{t('people.teaserInterests')}</li>
      </ul>
    </div>

    <div class="mt-6 flex flex-wrap gap-3">
      <a
        href="/saharanpur/meetups"
        class="inline-flex min-h-10 items-center rounded-xl bg-[var(--ac-accent)] px-4 py-2 text-sm font-semibold text-white hover:bg-[var(--ac-accent-hover)]"
      >
        {t('people.teaserCtaMeetups')}
      </a>
      <a
        href="/safety"
        class="inline-flex min-h-10 items-center rounded-xl border border-[var(--ac-border-strong)] px-4 py-2 text-sm font-semibold text-[var(--ac-ink)] hover:bg-[var(--ac-surface-muted)]"
      >
        {t('people.teaserCtaSafety')}
      </a>
    </div>
  </section>
</BaseLayout>
