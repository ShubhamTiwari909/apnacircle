---
import { t } from '@apnacircle/i18n';
const { kind, id } = Astro.props as { kind: 'host' | 'meetup'; id: string };
---

<form method="post" class="workspace-form mt-4">
  <input type="hidden" name="type" value={kind} />
  <input type="hidden" name="id" value={id} />
  {kind === 'host' && <label>{t('host.vettingMethod')}<select name="method">
    <option value="">{t('host.chooseMethod')}</option>
    <option value="video_call">{t('host.vettingCall')}</option>
    <option value="phone_call">{t('host.vettingPhone')}</option>
    <option value="in_person">{t('host.vettingInPerson')}</option>
  </select></label>}
  <label>{t('host.reviewNote')}<textarea name="note" rows="2" required minlength="10" maxlength="1000"></textarea></label>
  <div class="flex flex-wrap gap-2">
    <button class="workspace-button" name="decision" value="approve">{t('host.approve')}</button>
    <button class="workspace-secondary" name="decision" value="reject">{t('host.reject')}</button>
  </div>
</form>
