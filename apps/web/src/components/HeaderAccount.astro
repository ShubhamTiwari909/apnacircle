---
import { t } from '@apnacircle/i18n';
import { LEGACY_PROFILE_SESSION, PROFILE_AUTH_PATH, PROFILE_PATH, PROFILE_SESSION } from '../lib/profile-editor.js';

interface Props {
  signedIn?: boolean | undefined;
}
const token = Astro.props.signedIn === undefined && !Astro.isPrerendered
  ? (Astro.cookies.get(PROFILE_SESSION) ?? Astro.cookies.get(LEGACY_PROFILE_SESSION))?.value
  : undefined;
// This label is presentation only. Member routes independently verify the session and permissions.
const signedIn = Astro.props.signedIn ?? Boolean(token);
---

<a
  href={signedIn ? PROFILE_PATH : `${PROFILE_AUTH_PATH}?start=1`}
  class="inline-flex min-h-11 items-center justify-center whitespace-nowrap rounded-xl bg-[var(--ac-accent)] px-2.5 text-sm font-semibold text-white hover:bg-[var(--ac-accent-hover)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--ac-accent)] sm:px-4"
>
  {t(signedIn ? 'nav.account' : 'nav.signIn')}
</a>
