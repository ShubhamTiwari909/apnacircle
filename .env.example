# Copy to .env for local development. NEVER commit .env files.

# Public app metadata
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_ENVIRONMENT=development

# Cloudflare Turnstile (Cloudflare test keys shown for local dev only)
# Always-passes test sitekey: 1x00000000000000000000AA
# Always-passes test secret:  1x0000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Supabase (Phase 2 — Mumbai ap-south-1 projects; never put service role in browser or Workers)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Edge Function secrets (set with `supabase secrets set ...`; never in a committed file, never in Workers)
#   CRON_SECRET          shared secret pg_cron sends to the outbox-worker / nightly-jobs functions
#   RESEND_API_KEY       email provider key (Resend); FROM_EMAIL must be on a verified sender domain
#   FROM_EMAIL
#   SITE_URL             public site origin used in links inside emails and push messages
#   VAPID_PUBLIC_KEY     Web Push keys (generate once with `npx web-push generate-vapid-keys`)
#   VAPID_PRIVATE_KEY
#   VAPID_SUBJECT        mailto: contact for push services
# Database settings read by pg_cron triggers: app.supabase_project_id, app.cron_secret
