{
  "name": "apnacircle",
  "version": "0.1.0",
  "private": true,
  "description": "ApnaCircle — city-based social discovery and local meetup platform",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @apnacircle/web dev",
    "build": "pnpm --filter @apnacircle/types build && pnpm --filter @apnacircle/i18n build && pnpm --filter @apnacircle/ui build && pnpm --filter @apnacircle/web build",
    "lint": "eslint . && pnpm check:i18n",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:db": "bash scripts/test-db.sh",
    "test:e2e": "playwright test",
    "check:i18n": "pnpm --filter @apnacircle/i18n check",
    "check:policies": "python3 -I apnacircle-policies/fill_policies.py apnacircle-policies/placeholders.json apnacircle-policies/filled || true"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "1.65.1",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^5.1.2"
  }
}
